{
    "name": "@dpuse/dpuse-tool-marked-markdown-parser",
    "version": "0.1.23",
    "private": false,
    "description": "A library that wraps the Marked markdown parser and the Turndown HTML-to-markdown converter.",
    "license": "MIT",
    "author": "Jonathan Terrell <terrell.jm@gmail.com>",
    "type": "module",
    "sideEffects": false,
    "homepage": "https://www.dpuse.app",
    "bugs": {
        "url": "https://github.com/dpuse/dpuse-tool-marked-markdown-parser/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dpuse/dpuse-tool-marked-markdown-parser.git"
    },
    "module": "./dist/dpuse-tool-marked-markdown-parser.es.js",
    "types": "./dist/types/src/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/dpuse-tool-marked-markdown-parser.es.js",
            "types": "./dist/types/src/index.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=24",
        "npm": ">=12"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "version": ">=12",
            "onFail": "error"
        }
    },
    "prettier": "@dpuse/dpuse-development/prettierrc",
    "allowScripts": {
        "esbuild@0.28.1": true,
        "fsevents@2.3.3": true,
        "unrs-resolver@1.12.2": true,
        "workerd@1.20260926.1": true
    },
    "scripts": {
        "audit": "node -e \"import('@dpuse/dpuse-development').then(m => m.auditDependencies())\"",
        "build": "node -e \"import('@dpuse/dpuse-development').then(m => m.buildProject())\"",
        "check": "node -e \"import('@dpuse/dpuse-development').then(m => m.checkProject())\"",
        "document": "node -e \"import('@dpuse/dpuse-development').then(m => m.documentProject('CC0-1.0;BSD-2-Clause;MIT'))\"",
        "format": "node -e \"import('@dpuse/dpuse-development').then(m => m.formatCode())\"",
        "lint": "node -e \"import('@dpuse/dpuse-development').then(m => m.lintCode())\"",
        "release": "op run --env-file=.env -- node -e \"import('@dpuse/dpuse-development').then(m => m.releaseProject('CC0-1.0;BSD-2-Clause;MIT'))\"",
        "sync": "node -e \"import('@dpuse/dpuse-development').then(m => m.syncProjectWithGitHub())\"",
        "test": "node -e \"import('@dpuse/dpuse-development').then(m => m.testProject())\""
    },
    "dependencies": {
        "marked": "^18.0.14",
        "turndown": "^7.2.4"
    },
    "devDependencies": {
        "@dpuse/dpuse-development": "^0.3.793",
        "@dpuse/eslint-config-dpuse": "^1.0.123",
        "@types/node": "^26.6.3",
        "@types/turndown": "^5.0.6",
        "eslint": "^10.11.0",
        "prettier": "^3.9.9",
        "sonda": "^0.14.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.1",
        "vite-plugin-dts": "^5.1.1",
        "vitest": "^5.0.2",
        "wrangler": "^4.144.0"
    }
}
